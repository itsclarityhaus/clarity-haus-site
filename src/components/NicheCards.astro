---
// The three industries Clarity Haus knows best. Content lives in src/data/site.ts → niches.
import { niches } from '../data/site';
import Icon from './Icon.astro';
---
<ul class="niches" role="list">
  {niches.map((n, i) => (
    <li data-reveal style={`--reveal-i:${i}`}>
      <a class="niche" href={`/who-i-work-with/${n.slug}/`}>
        <span class="n-icon"><Icon name={n.icon} size={26} /></span>
        <h3 class="serif">{n.title}</h3>
        <p>{n.short}</p>
        <span class="n-more">Learn more <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .niches { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .niches li { display: flex; }
  .niche {
    flex: 1;
    display: flex; flex-direction: column; gap: var(--space-4);
    padding: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
  }
  .niche:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--color-sage); }
  .n-icon { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--color-sage-light); color: var(--color-green); }
  .niche h3 { font-size: var(--text-2xl); font-weight: 400; line-height: 1.05; }
  .niche p { color: var(--color-text-muted); flex: 1; }
  .n-more { display: inline-flex; align-items: center; gap: 0.4em; font-size: var(--text-sm); font-weight: 500; color: var(--color-green); }
  .n-more :global(svg) { transition: transform 0.25s var(--ease); }
  .niche:hover .n-more :global(svg) { transform: translateX(3px); }
  @media (max-width: 900px) { .niches { grid-template-columns: 1fr; max-width: 560px; } }
  @media (prefers-reduced-motion: reduce) { .niche, .niche:hover { transition: none; transform: none; } }
</style>
