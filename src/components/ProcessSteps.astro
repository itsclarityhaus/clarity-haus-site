---
import { processSteps } from '../data/site';
---
<ol class="process" role="list">
  {processSteps.map((step, i) => (
    <li class="step" data-reveal style={`--reveal-i:${i}`}>
      <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="step-body">
        <p class="step-label">Step {i + 1}</p>
        <h3>{step.title}</h3>
        <p class="step-text">{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process {
    list-style: none; padding: 0;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-5);
    position: relative;
  }
  /* connecting line on desktop */
  .process::before {
    content: ''; position: absolute; top: 27px; left: 28px; right: 28px;
    height: 1px; background: var(--color-border);
  }
  .step { position: relative; display: grid; gap: var(--space-5); align-content: start; }
  .num {
    position: relative; z-index: 1;
    width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    font-family: var(--font-serif); font-size: 1.35rem; color: var(--color-green);
  }
  .section-alt .num { background: var(--color-bg-alt); }
  .step:last-child .num { background: var(--color-green); border-color: var(--color-green); color: var(--color-on-green); }
  .step-body { display: grid; gap: var(--space-2); }
  .step-label { font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-sage); font-weight: 600; }
  .step-text { color: var(--color-text-muted); font-size: var(--text-sm); }

  @media (max-width: 960px) {
    .process { grid-template-columns: 1fr; gap: 0; }
    .process::before { top: 28px; bottom: 28px; left: 27px; right: auto; width: 1px; height: auto; }
    .step { grid-template-columns: 56px 1fr; gap: var(--space-5); padding-bottom: var(--space-6); }
    .step:last-child { padding-bottom: 0; }
    .step-body { padding-top: 0.35rem; }
    .step-text { font-size: var(--text-base); }
  }
</style>
