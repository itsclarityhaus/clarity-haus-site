---
// Workspace visual.
// ► To use a real photo: put the file in /public/images/ and pass
//   src="/images/your-photo.jpg" alt="..." — it renders a lazy-loaded,
//   responsive <img>. Without src, a line-art illustration is shown.
interface Props { src?: string; alt?: string; variant?: 'desk' | 'shelf'; class?: string }
const { src, alt = 'A calm workspace with a laptop, notebook, coffee, files, and a plant in natural light.', variant = 'desk', class: cls = '' } = Astro.props;
---
<figure class={`ws ${cls}`} data-reveal>
  {src ? (
    <img src={src} alt={alt} loading="lazy" decoding="async" width="1200" height="1400" />
  ) : variant === 'desk' ? (
    <svg viewBox="0 0 600 700" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt}>
      <defs>
        <linearGradient id="light-a" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FFFFFF" stop-opacity=".85" /><stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
        </linearGradient>
      </defs>
      <rect width="600" height="700" fill="#EFEEE7" />
      <!-- window light -->
      <path d="M340 0h200L330 470H130z" fill="url(#light-a)" opacity=".7" />
      <path d="M560 0h40v90L420 470h-50z" fill="url(#light-a)" opacity=".5" />
      <!-- desk -->
      <rect x="0" y="470" width="600" height="230" fill="#E4E8E0" />
      <path d="M0 470h600" stroke="#344536" stroke-width="1.6" />
      <g fill="none" stroke="#344536" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <!-- plant -->
        <path d="M470 470l-10-86h72l-10 86z" fill="#F8F7F2" />
        <path d="M496 384c-4-40-30-66-60-82M496 384c2-50 18-86 50-110M496 384c-18-30-20-70-6-104M496 384c14-24 40-40 70-44" />
        <path d="M436 302c14-2 26 6 30 18-14 2-26-6-30-18zM546 274c-2 14-12 24-26 26 2-14 12-24 26-26zM490 280c10 8 12 22 4 32-10-8-12-22-4-32zM566 340c-10 10-24 12-34 4 10-10 24-12 34-4z" fill="#E4E8E0" />
        <!-- laptop -->
        <path d="M150 300h210a8 8 0 0 1 8 8v142H142V308a8 8 0 0 1 8-8z" fill="#FFFFFF" />
        <rect x="160" y="316" width="190" height="118" rx="3" fill="#F8F7F2" />
        <path d="M112 450h286l-14 20H126z" fill="#F8F7F2" />
        <!-- mini chart on screen -->
        <path d="M176 410l30-22 26 12 34-30 30 10 36-26" stroke="#7D8878" />
        <path d="M176 340h60M176 352h36" stroke="#7D8878" />
        <!-- mug -->
        <path d="M60 400h56v56a14 14 0 0 1-14 14H74a14 14 0 0 1-14-14z" fill="#F8F7F2" />
        <path d="M116 414h8a12 12 0 0 1 0 24h-8" />
        <path d="M78 386c-6-10 6-14 0-24M96 386c-6-10 6-14 0-24" stroke="#7D8878" />
        <!-- notebook + pen -->
        <path d="M200 540l170-18 14 110-170 18z" fill="#FFFFFF" />
        <path d="M222 568l128-13M226 590l110-11M229 612l84-9" stroke="#7D8878" />
        <path d="M400 530l40 120" stroke-width="3" />
        <!-- folders -->
        <path d="M440 598h120v-60a6 6 0 0 0-6-6h-58l-10-12h-40a6 6 0 0 0-6 6z" fill="#F8F7F2" />
        <path d="M436 598h128v-52H436z" fill="#FFFFFF" />
        <path d="M452 566h60M452 580h40" stroke="#7D8878" />
        <!-- phone -->
        <rect x="52" y="540" width="64" height="112" rx="10" transform="rotate(-12 84 596)" fill="#FFFFFF" />
      </g>
    </svg>
  ) : (
    <svg viewBox="0 0 600 700" preserveAspectRatio="xMidYMid slice" role="img" aria-label={alt}>
      <rect width="600" height="700" fill="#E4E8E0" />
      <circle cx="430" cy="170" r="110" fill="#F8F7F2" opacity=".75" />
      <rect x="0" y="500" width="600" height="200" fill="#EFEEE7" />
      <path d="M0 500h600" stroke="#344536" stroke-width="1.6" />
      <g fill="none" stroke="#344536" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <!-- shelf -->
        <path d="M60 250h260" />
        <rect x="80" y="170" width="22" height="80" fill="#F8F7F2" /><rect x="106" y="182" width="18" height="68" fill="#FFFFFF" /><rect x="128" y="160" width="24" height="90" fill="#F8F7F2" />
        <path d="M170 250l18-80 18 4-18 76" fill="#FFFFFF" />
        <path d="M250 250v-40a26 26 0 0 1 52 0v40" fill="#F8F7F2" />
        <path d="M276 184c-6-26 6-40 22-50M276 184c-10-18-26-24-42-22" />
        <!-- floor lamp -->
        <path d="M400 230h80l22 80H378z" fill="#FFFFFF" />
        <path d="M440 310v190M410 500h60" />
        <!-- open notebook -->
        <path d="M110 560c40-14 80-14 120 0v90c-40-14-80-14-120 0zM230 560c40-14 80-14 120 0v90c-40-14-80-14-120 0z" fill="#FFFFFF" />
        <path d="M130 586c26-6 52-6 80 0M130 606c26-6 52-6 80 0M250 586c26-6 52-6 80 0M250 606c26-6 52-6 60 0" stroke="#7D8878" />
        <!-- coffee -->
        <path d="M420 590h50v40a12 12 0 0 1-12 12h-26a12 12 0 0 1-12-12z" fill="#F8F7F2" />
        <path d="M470 600h6a10 10 0 0 1 0 20h-6" />
        <ellipse cx="445" cy="648" rx="46" ry="8" />
      </g>
    </svg>
  )}
  <slot />
</figure>

<style>
  .ws {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    aspect-ratio: 6 / 7;
  }
  .ws svg, .ws img { width: 100%; height: 100%; object-fit: cover; }
</style>
