---
interface Props { eyebrow: string; title: string; intro?: string; center?: boolean }
const { eyebrow, title, intro, center = false } = Astro.props;
---
<section class:list={['page-hero', { center }]}>
  <div class="container">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--reveal-i:1" set:html={title} />
    {intro && <p class="lead" data-reveal style="--reveal-i:2">{intro}</p>}
    <div data-reveal style="--reveal-i:3"><slot /></div>
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(3.5rem, 2.5rem + 5vw, 7.5rem) clamp(3rem, 2rem + 4vw, 6rem); border-bottom: 1px solid var(--color-border); }
  .page-hero .container { display: grid; gap: var(--space-6); justify-items: start; }
  .page-hero h1 { font-size: var(--text-4xl); max-width: 14em; }
  .page-hero .lead { max-width: 40em; }
  .center .container { justify-items: center; text-align: center; }
  .center .lead { margin-inline: auto; }
</style>
