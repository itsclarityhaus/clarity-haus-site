---
import { creatorCategories } from '../data/site';
import Icon from './Icon.astro';
---
<ul class="cats" role="list">
  {creatorCategories.map((c, i) => (
    <li class="cat" data-reveal style={`--reveal-i:${i % 6}`}>
      <span class="cat-icon"><Icon name={c.icon} size={24} /></span>
      <span class="cat-label">{c.label}</span>
    </li>
  ))}
</ul>

<style>
  .cats {
    list-style: none; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3);
  }
  .cat {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4);
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.25s, transform 0.25s var(--ease);
  }
  .cat:hover { border-color: var(--color-sage); transform: translateY(-2px); }
  .cat-icon { color: var(--color-green); }
  .cat-label { font-size: var(--text-sm); font-weight: 500; }
  @media (max-width: 560px) {
    .cats { grid-template-columns: repeat(2, 1fr); }
    .cat { flex-direction: row; align-items: center; gap: var(--space-3); padding: 0.95rem 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cat, .cat:hover { transition: none; transform: none; } }
</style>
