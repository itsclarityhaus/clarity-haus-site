---
import Button from './Button.astro';
import Icon from './Icon.astro';
interface Props {
  title: string;
  subheading: string;
  copy: string;
  icon: string;
  cta: string;
  href: string;
  featured?: boolean;
  badge?: string;
  muted?: boolean;
  index?: number;
}
const { title, subheading, copy, icon, cta, href, featured = false, badge, muted = false, index = 0 } = Astro.props;
---
<article class:list={['service-card', { featured, muted }]} data-reveal style={`--reveal-i:${index}`}>
  {badge && <span class="badge">{badge}</span>}
  <span class="icon-wrap"><Icon name={icon} size={26} /></span>
  <p class="sub">{subheading}</p>
  <h3 class="serif title">{title}</h3>
  <p class="copy">{copy}</p>
  <div class="cta">
    <Button href={href} variant={featured ? 'light' : 'secondary'} arrow>{cta}</Button>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-4);
    padding: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .icon-wrap {
    width: 52px; height: 52px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--color-sage-light); color: var(--color-green);
    margin-bottom: var(--space-3);
  }
  .sub { font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-sage); }
  .title { font-size: var(--text-2xl); font-weight: 400; line-height: 1.05; }
  .copy { color: var(--color-text-muted); flex: 1; }
  .cta { margin-top: var(--space-4); }

  .featured { background: var(--color-green); border-color: var(--color-green); color: var(--color-on-green); box-shadow: var(--shadow-lg); }
  .featured .icon-wrap { background: rgba(248, 247, 242, 0.12); color: var(--color-on-green); }
  .featured .sub { color: var(--color-on-green-muted); }
  .featured .copy { color: var(--color-on-green-muted); }
  .badge {
    position: absolute; top: 1.5rem; right: 1.5rem;
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.35em 0.85em; border-radius: var(--radius-pill);
    background: rgba(248, 247, 242, 0.14); color: var(--color-on-green);
  }
  .muted { background: transparent; box-shadow: none; border-style: dashed; }
  .service-card:not(.featured) .badge { background: var(--color-sage-light); color: var(--color-green); }

  @media (min-width: 1000px) {
    .featured { transform: translateY(-16px); }
    .featured:hover { transform: translateY(-20px); }
  }
  @media (prefers-reduced-motion: reduce) { .service-card, .service-card:hover { transition: none; transform: none; } }
</style>
